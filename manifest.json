{
  "manifest_version": 3,
  "name": "E-edition Cleanup",
  "version": "1.1.0",
  "description": "Cleans up e-edition pages on your configured sites.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.dailycamera.com/*",
    "*://*.denverpost.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
